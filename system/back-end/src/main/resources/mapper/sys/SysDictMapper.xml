<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cy.single.blog.dao.SysDictMapper">

    <!-- 通用查询结果列 -->
    <sql id="Table_Name">
        sys_dict
    </sql>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, surrogate_id, `name`, remark, operator, operate_ip, create_time, update_time, deleted
    </sql>

    <select id="getDict" resultType="com.cy.single.blog.pojo.vo.sys.dic.SysDictVO">
        select <include refid="Base_Column_List" />
        from <include refid="Table_Name" />
        where surrogate_id = #{surrogateId}
    </select>
</mapper>
