<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cy.single.blog.dao.SysDictDetailMapper">

    <!-- 通用查询结果列 -->
    <sql id="Table_Name">
        sys_dict_detail
    </sql>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        surrogate_id, parent_id, `name`, `type`, remark
    </sql>

    <!--分页查询字典明细-->
<!--    <select id="listDetailPage" resultMap="BaseResultMap">-->
<!--        select <include refid="Base_Column_List"/>-->
<!--        from <include refid="Table_Name"/>-->
<!--        where parent_id = #{param.sysDictId}-->
<!--    </select>-->

    <select id="getDictDetailListByParentId" resultType="com.cy.single.blog.pojo.vo.sys.dic.SysDictDetailVO">
        select <include refid="Base_Column_List"/>
        from <include refid="Table_Name"/>
        where parent_id = #{dictSurrogateId}
    </select>

    <!--  -->
    <select id="pageDictDetailListById" resultType="com.cy.single.blog.pojo.vo.sys.dic.SysDictDetailVO">
        select <include refid="Base_Column_List"/>
        from <include refid="Table_Name"/>
        <where>
            <if test="param.name != null and param.name != ''">
                and name = #{param.name}
            </if>
            <if test="param.type != null">
                and `type` = #{param.type}
            </if>
            <if test="param.dictId != null">
                and parent_id = #{param.dictId}
            </if>
            <if test="param.keyWords!=null and param.keyWords!=''">
                and (
                `type` like concat('%',#{param.keyWords},'%')
                or
                `name` like concat('%',#{param.keyWords},'%')
                )
            </if>
        </where>
    </select>

    <select id="countPageDictDetail" resultType="java.lang.Integer">
        select count(1)
        from <include refid="Table_Name"/>
        <where>
            <if test="param.name != null and param.name != ''">
                and name = #{param.name}
            </if>
            <if test="param.type != null">
                and `type` = #{param.type}
            </if>
            <if test="param.dictId != null">
                and parent_id = #{param.dictId}
            </if>
            <if test="param.keyWords!=null and param.keyWords!=''">
                and (
                `type` like concat('%',#{param.keyWords},'%')
                or
                `name` like concat('%',#{param.keyWords},'%')
                )
            </if>
        </where>
    </select>
</mapper>
